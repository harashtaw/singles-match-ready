{
"version": 2,
"name": "singles-match-ready",
"cleanUrls": true,
"trailingSlash": false,
"headers": [
{
"source": "/(.)",
"headers": [
{
"key": "Cache-Control",
"value": "public, max-age=0, must-revalidate"
},
{
"key": "X-Content-Type-Options",
"value": "nosniff"
},
{
"key": "X-Frame-Options",
"value": "DENY"
}
]
}
],
"routes": [
{
"src": "/(.)",
"dest": "/index.html"
}
]
}
